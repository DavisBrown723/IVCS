// Run with tests/tasks/run.ps1 -TestScript tests/simulation/time.sqf.
waitUntil { time > 0 };
private _passed = 0; private _failed = 0;
private _assert = {
    params ["_ok","_label"];
    if (_ok) then { _passed = _passed + 1; } else { _failed = _failed + 1; };
    diag_log format ["[IVCS TASK TEST] %1 %2",if (_ok) then {"PASS"} else {"FAIL"},_label];
};
private _clockEH = IVCS_SimulationTime_FrameEH;
private _before = IVCS_SimulationTime;
[] call IVCS_Common_startSimulationClock;
[IVCS_SimulationTime_FrameEH == _clockEH && { IVCS_SimulationTime == _before },"repeated clock startup preserves time and handler"] call _assert;
private _wall = diag_tickTime;
sleep 0.3;
[abs ((IVCS_SimulationTime - _before) - (diag_tickTime - _wall) * accTime) < 0.1,"real frame clock integrates diag_tickTime with accTime"] call _assert;
[IVCS_SimulationPaused isEqualTo isGamePaused,"public pause state matches the engine"] call _assert;
removeMissionEventHandler ["EachFrame",_clockEH];
IVCS_SimulationTime = 0; IVCS_SimulationTime_LastTick = 100;
[100.5,false,1] call IVCS_Common_updateSimulationTime;
[IVCS_SimulationTime == 0.5,"1x advances one simulation second per real second"] call _assert;
[101.5,false,5] call IVCS_Common_updateSimulationTime;
[IVCS_SimulationTime == 5.5,"5x advances five simulation seconds per real second"] call _assert;
[200,true,5] call IVCS_Common_updateSimulationTime;
[IVCS_SimulationTime == 5.5 && { IVCS_SimulationPaused },"pause freezes simulation time"] call _assert;
[300,true,1] call IVCS_Common_updateSimulationTime;
[IVCS_SimulationTime == 5.5 && { IVCS_SimulationTime_LastTick == 300 },"paused updates still consume wall-clock time"] call _assert;
[301,false,1] call IVCS_Common_updateSimulationTime;
[IVCS_SimulationTime == 6.5 && { !IVCS_SimulationPaused },"resume adds only the new unpaused interval"] call _assert;
[301,false,5] call IVCS_Common_updateSimulationTime;
[IVCS_SimulationTime == 6.5,"same timestamp cannot advance time twice"] call _assert;
[302,false,0] call IVCS_Common_updateSimulationTime;
[IVCS_SimulationTime == 6.5 && { !IVCS_SimulationPaused },"zero speed freezes time without claiming Arma is paused"] call _assert;
[304,false,0.5] call IVCS_Common_updateSimulationTime;
[IVCS_SimulationTime == 7.5,"fractional speed is supported"] call _assert;

call compile preprocessFileLineNumbers "IVCS\EntityTasks\startup.sqf";
IVCS_Common_WeaponInfo = createHashMap; IVCS_Common_MagazineInfo = createHashMap;
IVCS_Common_AmmoInfo = createHashMap; IVCS_Common_UnitInfo = createHashMap;
IVCS_Common_WeaponAliases = createHashMap;
IVCS_Paths_Generator = createHashMapFromArray [["requestQueue",[]],["currentRequest",[]]];
IVCS_VirtualSpace_Controller = [false] call IVCS_VirtualSpace_createController;
removeMissionEventHandler ["EachFrame",IVCS_VirtualSpace_Controller get "onFrameHandlerID"];
private _combat = IVCS_VirtualSpace_Controller get "combat";
_combat set ["accuracyScale",0]; _combat set ["frameBudgetMs",0];
west setFriend [east,0]; east setFriend [west,0];
private _make = {
    params ["_side","_position",["_count",1]];
    private _units = [];
    for "_i" from 0 to (_count - 1) do { _units pushBack (["B_Soldier_F",format ["u_%1",_i]] call IVCS_VirtualSpace_Group_createUnit); };
    [_side,"BLU_F",_position,_units] call IVCS_VirtualSpace_Group_createEntity
};
private _blue = ["WEST",[14500,16400,0]] call _make;
private _red = ["EAST",[14700,16400,0]] call _make;
[_blue get "timeLastUpdate" == IVCS_SimulationTime,"new entity timestamps use the shared epoch"] call _assert;
private _waypoint = [[14600,16400,0],"MOVE",[["speed","NORMAL"]]] call IVCS_VirtualSpace_createEntityWaypoint;
[_blue,_waypoint] call IVCS_VirtualSpace_entityAddWaypoint;
_waypoint set ["initialized",true]; _waypoint set ["pathGenerationRequestID","clock-test"];
_waypoint set ["movePoints",[[14600,16400,0]]];
_blue set ["nextCombatScan",10000]; _red set ["nextCombatScan",10000];
[305,false,1] call IVCS_Common_updateSimulationTime;
[306,false,5] call IVCS_Common_updateSimulationTime;
[] call IVCS_VirtualSpace_simulateEntities;
[abs (((_blue get "position") distance2D [14500,16400,0]) - 6 * (_blue get "moveSpeedPerSecond")) < 0.01,"movement integrates speed changes between sparse entity visits"] call _assert;
private _engagement = [_blue,_red] call IVCS_Combat_start;
[_engagement get "lastUpdate" == IVCS_SimulationTime && { _blue get "combatStartedAt" == IVCS_SimulationTime },"combat and task-pause timestamps share the clock"] call _assert;
[307,false,5] call IVCS_Common_updateSimulationTime;
[] call IVCS_Combat_onFrame;
[(_engagement get "elapsed") == 1 && { (_engagement get "pending") == 4 },"5x creates five seconds of combat work with one exchange per visit"] call _assert;
for "_i" from 1 to 4 do { [] call IVCS_Combat_onFrame; };
[(_engagement get "elapsed") == 5 && { (_engagement get "pending") == 0 },"combat catchup drains without a second clock or double scaling"] call _assert;
private _position = +(_blue get "position"); private _shots = _engagement get "shots";
[400,true,5] call IVCS_Common_updateSimulationTime;
[] call IVCS_VirtualSpace_onFrame;
[(_engagement get "shots") == _shots && { (_blue get "position") isEqualTo _position },"paused gameplay frame cannot move or fire"] call _assert;
[401,false,1] call IVCS_Common_updateSimulationTime;
[] call IVCS_Combat_onFrame;
[(_engagement get "elapsed") == 6,"combat resume does not replay paused wall time"] call _assert;
[_engagement get "id"] call IVCS_Combat_finish;

private _sharing = ["WEST",[15000,16400,0],2] call _make;
private _recipient = (_sharing get "units") select 0; private _donor = (_sharing get "units") select 1;
_recipient set ["weapons",[["arifle_MX_F",[]]]]; _recipient set ["magazineCargo",[]];
_donor set ["weapons",[["arifle_MX_F",[["30Rnd_65x39_caseless_mag",30,[]],["30Rnd_65x39_caseless_mag",30,[]],["30Rnd_65x39_caseless_mag",15,[]]]]]];
_donor set ["magazineCargo",[]];
[_sharing,IVCS_SimulationTime,false] call IVCS_Ammo_updateGroup;
[count (_sharing get "ammoRequests") == 1,"shortage discovery uses shared-time defaults"] call _assert;
private _request = (_sharing get "ammoRequests") select 0;
[(_request get "arriveAt") == IVCS_SimulationTime + 3,"ammo approach deadline uses simulation seconds"] call _assert;
[500,true,5] call IVCS_Common_updateSimulationTime;
[] call IVCS_Ammo_onFrame; [] call IVCS_Ammo_searchOnFrame;
[(_sharing get "ammoTransfers") == 0,"paused ammo sharing cannot complete a transfer"] call _assert;
[501,false,5] call IVCS_Common_updateSimulationTime;
[_sharing,IVCS_SimulationTime,false] call IVCS_Ammo_updateGroup;
[(_sharing get "ammoTransfers") == 1 && { (_recipient get "fireDelay") >= 3 },"five simulated seconds complete approach and collection with reload retained"] call _assert;

// Exercise the real GET IN and LAND timeout callbacks against a distant virtual vehicle.
private _registry = (IVCS_VirtualSpace_Controller get "entities") get "ALL";
_registry set ["clock_vehicle",createHashMapFromArray [["entityType","vehicle"],["active",false],["position",[10000,10000,100]]]];
private _boarding = ["GET IN",[["vehicleID","clock_vehicle"],["timeout",3]]] call IVCS_EntityTasks_createTaskInstance;
private _landing = ["LAND",[["landingPosition",[11000,11000,0]],["timeout",3]]] call IVCS_EntityTasks_createTaskInstance;
(_boarding get "context") set ["startedAt",IVCS_SimulationTime];
(_landing get "context") set ["startedAt",IVCS_SimulationTime];
(_landing get "context") set ["vehicleID","clock_vehicle"];
private _boardingUpdate = ((_boarding get "template" get "states") get "rendezvous") get "onUpdate";
private _landingUpdate = ((_landing get "template" get "states") get "landing") get "onUpdate";
[600,true,5] call IVCS_Common_updateSimulationTime;
[!(((_boarding get "context") call _boardingUpdate) == "failed") && { !(((_landing get "context") call _landingUpdate) == "failed") },"task timeout clocks do not age during a pause"] call _assert;
[601,false,5] call IVCS_Common_updateSimulationTime;
[((_boarding get "context") call _boardingUpdate) == "failed" && { ((_landing get "context") call _landingUpdate) == "failed" },"boarding and landing timeouts scale with the shared clock"] call _assert;
_registry deleteAt "clock_vehicle";

IVCS_CurrentFrame = 0;
IVCS_Execution_controller = [] call IVCS_Execution_createController;
removeMissionEventHandler ["EachFrame",IVCS_Execution_controller get "onFrameHandlerID"];
IVCS_Time_TestOnce = 0; IVCS_Time_TestRepeats = 0;
[{ IVCS_Time_TestOnce = IVCS_Time_TestOnce + 1; },[],3] call IVCS_Execution_executeAfterSeconds;
[{ IVCS_Time_TestRepeats = IVCS_Time_TestRepeats + 1; },[],3] call IVCS_Execution_executeEverySeconds;
[700,true,5] call IVCS_Common_updateSimulationTime;
[] call IVCS_Execution_onFrame;
[IVCS_Time_TestOnce == 0 && { IVCS_Time_TestRepeats == 0 },"paused delayed callbacks stay pending"] call _assert;
[701,false,5] call IVCS_Common_updateSimulationTime;
[] call IVCS_Execution_onFrame; [] call IVCS_Execution_onFrame;
[IVCS_Time_TestOnce == 1 && { IVCS_Time_TestRepeats == 1 },"scaled deadlines execute once without replaying missed repeats"] call _assert;
[704,false,1] call IVCS_Common_updateSimulationTime;
[] call IVCS_Execution_onFrame;
[IVCS_Time_TestOnce == 1 && { IVCS_Time_TestRepeats == 2 },"repeating callbacks reschedule in simulation seconds"] call _assert;
// A paused path request cannot fail merely because diag_tickTime advanced.
IVCS_Time_TestPathExpired = 0;
IVCS_Time_OriginalPathGenerated = IVCS_Paths_onPathGenerated;
IVCS_Paths_onPathGenerated = { IVCS_Time_TestPathExpired = IVCS_Time_TestPathExpired + 1; };
IVCS_Paths_Generator set ["currentRequest",["clock_path","man","SAFE",[0,0,0],[1,0,0],[],{},IVCS_SimulationTime]];
[800,true,5] call IVCS_Common_updateSimulationTime;
[] call IVCS_Paths_onFrame;
[IVCS_Time_TestPathExpired == 0,"paused path requests cannot time out"] call _assert;
[801,false,5] call IVCS_Common_updateSimulationTime;
[] call IVCS_Paths_onFrame;
[IVCS_Time_TestPathExpired == 0,"path timeout retains its remaining simulation seconds"] call _assert;
[803,false,5] call IVCS_Common_updateSimulationTime;
[] call IVCS_Paths_onFrame;
[IVCS_Time_TestPathExpired == 1,"path request timeout advances with simulation speed"] call _assert;
IVCS_Paths_onPathGenerated = IVCS_Time_OriginalPathGenerated;
IVCS_Paths_Generator set ["currentRequest",[]];
{ [_x] call IVCS_VirtualSpace_unregisterEntity; } forEach [_blue,_red,_sharing];
diag_log format ["[IVCS TASK TEST] DONE passed=%1 failed=%2",_passed,_failed];
