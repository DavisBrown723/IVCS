[_idle] call _scan;
[(_idle get "combatID") in [_e1 get "id",_e2 get "id"],"idle virtual AA still joins an existing air fight"] call _assert;
private _busy=["O_Soldier_AA_F","EAST",1,[14600,16400,0]] call _make;
private _ground=["B_Soldier_F","WEST",4,[14500,16400,0]] call _make;
