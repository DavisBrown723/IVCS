[((_busy get "units" select 0) get "fireDelay")==6,"a ground-to-air transfer preserves its firing delay"] call _assert;
[_ground,[19000,16400,0]] call IVCS_VirtualSpace_setEntityPosition;
[_e1 get "id"] call IVCS_Combat_finish;
[_h1,[19000,16400,100]] call IVCS_VirtualSpace_setEntityPosition;
[_crew1,[19000,16400,100]] call IVCS_VirtualSpace_setEntityPosition;
[_aa] call _scan;
[(_aa get "combatID")==(_e2 get "id"),"released AA can discover and join another fight on its next scan"] call _assert;
