private _supports=+(_e1 get "supporters");private _members=+(_e1 get "members");
{
    private _mode=_x;_e1 set ["mode",_mode];
    {
        _x set ["nextCombatScan",0];IVCS_Admission_Starts=0;[_x] call IVCS_Review_BeforeFindTarget;
        private _before=IVCS_Admission_Starts;private _after=[_x] call _scan;
        [_after==0 && {if ((_x get "vehicleType")=="helicopter") then {_before==0} else {_before>0}},format ["%1 member %2 skips all rejected candidate starts",_mode,_x get "entityType"]] call _assert;
        [(_x get "combatID")==(_e1 get "id"),"blocked discovery retains the engagement owner"] call _assert;
    } forEach [_a1,_crew1,_aa,_v,_vc,_h1];
} forEach ["virtual","native","spawning","capturing"];
_e1 set ["mode","virtual"];
[(_e1 get "supporters") isEqualTo _supports && {(_e1 get "members") isEqualTo _members} && {count (_combat get "queue")==2},"skipped scans preserve support, linked crews and scheduler entries"] call _assert;
[isNil {[_aa,_h2] call IVCS_Combat_start},"direct admission still enforces the same air-engagement ownership rule"] call _assert;
IVCS_Combat_start={IVCS_Admission_Starts=IVCS_Admission_Starts+1;nil};
_h1 set ["damage",1];
[([_aa] call _scan)>0,"eligibility uses the current pair predicate when the old aircraft is no longer a valid target"] call _assert;
_h1 set ["damage",0];
_aa set ["combatID","missing-engagement"];
